APP_NAME="GMNHS PPEI"
APP_ENV=production
# Generate on the server after copying this file to .env: php artisan key:generate
APP_KEY=
APP_DEBUG=false
# Replace with the live domain (https)
APP_URL=https://your-domain.com

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u669236935_gmnhs
DB_USERNAME=u669236935_gmnhs
DB_PASSWORD="Gmnhs@2026"

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Absolute path to wkhtmltopdf on the server (needed for report and return slip PDFs)
WKHTMLTOPDF_BINARY=
